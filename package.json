{
  "name": "@buildsip/agent-session-parser",
  "version": "0.1.0",
  "description": "Parse AI agent conversation sessions stored on the user's machine.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "prepack": "node scripts/build.mjs",
    "release": "node scripts/release.mjs",
    "format": "oxfmt --write src scripts README.md",
    "build": "node scripts/build.mjs"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "codex",
    "claude",
    "copilot",
    "gemini",
    "opencode",
    "droid",
    "factory",
    "session",
    "context",
    "developer-tools",
    "cursor"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "5.9.2",
    "vitest": "^4.0.18",
    "zod": "^4.4.3",
    "oxlint": "^1.65.0",
    "oxfmt": "^0.50.0"
  },
  "homepage": "https://github.com/buildsip/agent-session-parser#readme",
  "bugs": {
    "url": "https://github.com/buildsip/agent-session-parser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildsip/agent-session-parser.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
